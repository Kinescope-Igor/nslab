# BrowserStack benchmark outputs — JSON/MD per run, не нужны в репо.
bench/out/

# TypeScript build artifacts (vite сам бандлит, локальный tsc может налить лишнего)
tsconfig.tsbuildinfo
src/**/*.js
src/**/*.d.ts

# DTLN runtime files copied via postinstall (scripts/copy-dtln-assets.mjs)
