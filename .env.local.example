# BrowserStack credentials для bench:bs скрипта.
# Получить в https://www.browserstack.com/accounts/settings → Service Accounts
# (или User-level keys), нужен план Automate / Automate Mobile.
#
# Скопируй этот файл в .env.local и подставь свои значения.
# .env.local в .gitignore — не коммитится.

BROWSERSTACK_USERNAME=igor_xxx
BROWSERSTACK_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Опционально: переопределить URL стенда (по умолчанию https://speak.kn.pe/lab/noise-bench/)
# NSLAB_URL=https://your-staging.example.com/lab/noise-bench/
